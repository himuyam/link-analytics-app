# Database
DATABASE_URL="postgresql://user:password@localhost:5432/link_analytics_dev"

# Authentication
AUTH_SECRET="generate-a-secure-random-string-here-min-32-characters"
AUTH_SALT="generate-another-secure-random-string-here"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Security
SESSION_COOKIE_NAME="__Host-session"
SESSION_MAX_AGE=604800

# Rate Limiting
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTRATION_WINDOW_MS=3600000
RATE_LIMIT_REGISTRATION_MAX_ATTEMPTS=3
RATE_LIMIT_LINK_CREATION_WINDOW_MS=3600000
RATE_LIMIT_LINK_CREATION_MAX_ATTEMPTS=20

# Maps (using Leaflet with OpenStreetMap - no API key needed)
NEXT_PUBLIC_MAP_PROVIDER="openstreetmap"

# Logging
LOG_LEVEL="info"

# Feature Flags
ENABLE_REAL_TIME_UPDATES="true"
ENABLE_MAP_VISUALIZATION="true"

# Data Retention (days)
DEFAULT_RETENTION_DAYS=30
MAX_RETENTION_DAYS=365
